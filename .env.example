# Public origin used in canonical + OG URLs at build time.
# Copy to .env.production locally; do not commit secrets here.
KELLOS_SITE_URL=https://kellos.vercel.app
VITE_SITE_URL=https://kellos.vercel.app

# --- Phase 11 editing API (Fastify + Mongo). Not used by the visitor Vite app. ---
# Copy to .env locally. Never commit real values. If a URI was pasted in chat, rotate it.
# MONGODB_URI=mongodb+srv://USER:PASS@HOST/kellos_edit
# MONGODB_DB=kellos_edit
# KELLOS_ADMIN_TOKEN=
# KELLOS_ADMIN_ORIGIN=http://127.0.0.1:5174
# KELLOS_EDIT_HOST=127.0.0.1
# KELLOS_EDIT_PORT=8787

# --- Phase 12 admin Vite app (npm run admin). Not the visitor site. Never Vercel static. ---
# Token stays in the admin session, not in VITE_* (would bake into a bundle).

# --- Phase 13 publish-to-static (npm run publish). Not Vercel’s visitor build. ---
# KELLOS_EDIT_URL=http://127.0.0.1:8787
# KELLOS_EMIT_ROOT=   # default: cwd (the KellOS repo)
# KELLOS_SKIP_DEPLOY=1  # write JSON only; skip npm run build
# KELLOS_DEPLOY_CMD=    # optional extra hook after npm run build (never npm run server)
